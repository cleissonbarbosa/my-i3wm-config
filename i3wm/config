# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $mod Mod4

# >>> theme colors (managed by themes/theme-switcher.sh — do not edit) >>>
set $backgroundColor #1e1e2e
set $selection #313244
set $comment #6c7086
set $foreground #cdd6f4

set $yellow #f9e2af
set $orange #fab387
set $red #f38ba8
set $magenta #cba6f7
set $blue #89b4fa
set $cyan #89dceb
set $green #a6e3a1
# <<< theme colors <<<


# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:JetBrainsMono Nerd Font 8

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex --autostart --environment i3

# Lock screen: the i3lock-color invocation lives in a single script shared by
# xss-lock (suspend/loginctl) and the manual $mod+Escape binding.
set $locker ~/.config/i3/scripts/lock-screen.sh

# xss-lock grabs a logind suspend inhibit lock and will use the locker to lock
# the screen before suspend. Use loginctl lock-session to lock your screen.
exec --no-startup-id xss-lock --transfer-sleep-lock -- $locker

# Lock the screen manually
bindsym $mod+Escape exec --no-startup-id loginctl lock-session

# NetworkManager is the most popular way to manage wireless networks on Linux,
# and nm-applet is a desktop environment-independent system tray GUI for it.
exec --no-startup-id nm-applet

# Volume control (PipeWire/WirePlumber): 5% steps, capped at 100%,
# with a dunst OSD progress bar.
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/volume-osd.sh up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/volume-osd.sh down
bindsym XF86AudioMute exec --no-startup-id ~/.config/i3/scripts/volume-osd.sh mute
bindsym XF86AudioMicMute exec --no-startup-id ~/.config/i3/scripts/volume-osd.sh mic-mute

# Media control
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioStop exec playerctl stop

# Brightness control (with dunst OSD)
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/i3/scripts/brightness-osd.sh up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/scripts/brightness-osd.sh down

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking anywhere into the
# window while holding the floating modifier (title bars are disabled).
tiling_drag modifier

# start a terminal
bindsym $mod+Return exec wezterm

# kill focused window
bindsym $mod+Shift+q kill

# change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+ccedilla focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+ccedilla move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# scratchpad: hide the focused window / cycle through hidden windows
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Quake-style dropdown terminal (dedicated WezTerm on the scratchpad)
bindsym $mod+t exec --no-startup-id ~/.config/i3/scripts/dropdown-terminal.sh
for_window [class="dropdown-terminal"] floating enable, resize set 70 ppt 65 ppt, move scratchpad, scratchpad show

# ignore Libadwaita
exec --no-startup-id systemctl --user set-environment ADW_DISABLE_PORTAL=1

# Open Gnome Settings
bindsym $mod+Shift+s exec --no-startup-id XDG_CURRENT_DESKTOP=GNOME gnome-control-center

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Pin workspaces to monitors: odd on the left (DP-0), even on the right (DP-4).
# Each lists the other output as fallback for single-monitor sessions.
workspace $ws1 output DP-0 DP-4
workspace $ws2 output DP-4 DP-0
workspace $ws3 output DP-0 DP-4
workspace $ws4 output DP-4 DP-0
workspace $ws5 output DP-0 DP-4
workspace $ws6 output DP-4 DP-0
workspace $ws7 output DP-0 DP-4
workspace $ws8 output DP-4 DP-0
workspace $ws9 output DP-0 DP-4
workspace $ws10 output DP-4 DP-0

# Pressing the current workspace's key again jumps back to the previous one
workspace_auto_back_and_forth yes
bindsym $mod+Tab workspace back_and_forth

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym --release $mod+Mod2+KP_1 workspace number $ws1
bindsym --release $mod+Mod2+KP_2 workspace number $ws2
bindsym --release $mod+Mod2+KP_3 workspace number $ws3
bindsym --release $mod+Mod2+KP_4 workspace number $ws4
bindsym --release $mod+Mod2+KP_5 workspace number $ws5
bindsym --release $mod+Mod2+KP_6 workspace number $ws6
bindsym --release $mod+Mod2+KP_7 workspace number $ws7
bindsym --release $mod+Mod2+KP_8 workspace number $ws8
bindsym --release $mod+Mod2+KP_9 workspace number $ws9
bindsym --release $mod+Mod2+KP_0 workspace number $ws10


# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10


bindsym --release $mod+Shift+KP_End move container to workspace number $ws1
bindsym --release $mod+Shift+KP_Down move container to workspace number $ws2
bindsym --release $mod+Shift+KP_Next move container to workspace number $ws3
bindsym --release $mod+Shift+KP_Left move container to workspace number $ws4
bindsym --release $mod+Shift+KP_Begin move container to workspace number $ws5
bindsym --release $mod+Shift+KP_Right move container to workspace number $ws6
bindsym --release $mod+Shift+KP_Home move container to workspace number $ws7
bindsym --release $mod+Shift+KP_Up move container to workspace number $ws8
bindsym --release $mod+Shift+KP_Prior move container to workspace number $ws9
bindsym --release $mod+Shift+KP_Insert move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym ccedilla resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# adjust gaps on the fly
set $mode_gaps Gaps: (i)nner+ (Shift+i)nner- (o)uter+ (Shift+o)uter- (0) reset
mode "$mode_gaps" {
        bindsym i gaps inner current plus 5
        bindsym Shift+i gaps inner current minus 5
        bindsym o gaps outer current plus 5
        bindsym Shift+o gaps outer current minus 5
        bindsym 0 gaps inner current set 10; gaps outer current set 5

        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+Shift+g mode "$mode_gaps"


# Disable title bars and borders (required for gaps to work correctly)
default_border pixel 0
default_floating_border pixel 0


# Spacing between windows (Inner Gaps)
gaps inner 10

# Spacing between windows and screen edges (Outer Gaps)
gaps outer 5

smart_gaps on


# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
        status_command i3status-rs ~/.config/i3status/config.toml

        font pango:JetBrainsMono Nerd Font 10
        tray_output primary
        tray_padding 4
        height 25
        position top

        colors {
          background $backgroundColor
          statusline $foreground
          separator  $selection

          focused_workspace  $selection $selection $foreground
          active_workspace   $backgroundColor $selection $foreground
          inactive_workspace $backgroundColor $backgroundColor #BFBFBF
          urgent_workspace   $red $red $foreground
          binding_mode       $red $red $foreground
        }
}

# Monitor layout: single xrandr call avoids races between mode and position,
# and marks DP-0 as primary (used by tray_output above).
exec_always --no-startup-id xrandr --output DP-0 --mode 1920x1080 --rate 144.00 --primary --output DP-4 --mode 1920x1080 --rate 144.00 --right-of DP-0
# exec_always --no-startup-id ~/.config/i3/scripts/i3-alternating-layout/alternating_layouts.py

# class                 border  bground text    indicator child_border
client.focused          $comment $comment $foreground $comment   $comment
client.focused_inactive $selection $selection $foreground $selection   $selection
client.unfocused        $backgroundColor $backgroundColor #BFBFBF $backgroundColor   $backgroundColor
client.urgent           $selection $red $foreground $red   $red
client.placeholder      $backgroundColor $backgroundColor $foreground $backgroundColor   $backgroundColor

client.background       $foreground


# Rofi launcher
bindsym $mod+d exec --no-startup-id ~/.local/bin/rofi_launcher.sh
bindsym $mod+Shift+d exec --no-startup-id ~/.local/bin/rofi_sudo_launcher.sh

# Rofi power menu
bindsym $mod+p exec --no-startup-id ~/.local/bin/rofi_powermenu.sh

# Clipboard history (greenclip + rofi)
bindsym $mod+Shift+v exec --no-startup-id ~/.local/bin/rofi_clipboard.sh

# Calculator and emoji picker
bindsym $mod+equal exec --no-startup-id ~/.local/bin/rofi_calc.sh
bindsym $mod+period exec --no-startup-id sh -c 'command -v rofimoji >/dev/null && rofimoji --action copy'

# Rice/theme selector (Dracula, Gruvbox, Catppuccin, ...)
bindsym $mod+Shift+t exec --no-startup-id ~/.local/bin/theme-switcher.sh

# eww control-center dashboard
bindsym $mod+o exec --no-startup-id sh -c 'command -v eww >/dev/null && eww open --toggle dashboard'

# Save/restore workspace layout + programs (i3-resurrect)
bindsym $mod+F9 exec --no-startup-id sh -c 'command -v i3-resurrect >/dev/null && i3-resurrect save && notify-send -a i3-resurrect "󰆓 Workspace salvo"'
bindsym $mod+F10 exec --no-startup-id sh -c 'command -v i3-resurrect >/dev/null && i3-resurrect restore'

# background images slideshow (guarded against duplicate instances)
exec --no-startup-id ~/.config/i3/scripts/wallpaper-slideshow.sh

# enable num lock
exec --no-startup-id numlockx on

# clipboard history daemon
exec --no-startup-id sh -c 'command -v greenclip >/dev/null && greenclip daemon'

# flash the window that receives focus (needs the compositor)
exec --no-startup-id sh -c 'command -v flashfocus >/dev/null && flashfocus'

# eww daemon (widgets)
exec --no-startup-id sh -c 'command -v eww >/dev/null && eww daemon'

# Compositor: kill any previous instance so an i3 restart picks up config changes
# (the pause lets the old instance release the compositor selection / GLX context)
exec_always --no-startup-id sh -c 'pkill -x picom; sleep 0.5; picom -b --config ~/.config/picom/picom.conf'

# Start the Flameshot daemon (important for Flatpak)
exec --no-startup-id flatpak run org.flameshot.Flameshot

# Screenshot via Flatpak
bindsym Print exec --no-startup-id flatpak run org.flameshot.Flameshot gui

bindsym $mod+b exec --no-startup-id brave-browser
bindsym $mod+c exec --no-startup-id google-chrome

for_window [class="rustdesk"] floating enable
for_window [class="Slack"] focus

bindsym $mod+Shift+n exec dunstctl history-pop
bindsym $mod+Shift+h exec ~/.local/bin/dunst-history.sh
