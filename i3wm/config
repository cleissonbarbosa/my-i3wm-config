# i3 config file (v4) — https://i3wm.org/docs/userguide.html

set $mod Mod4

# >>> theme colors (managed by themes/theme-switcher.sh — do not edit) >>>
set $backgroundColor #1e1e2e
set $selection #313244
set $comment #6c7086
set $foreground #cdd6f4

set $yellow #f9e2af
set $orange #fab387
set $red #f38ba8
set $magenta #cba6f7
set $blue #89b4fa
set $cyan #89dceb
set $green #a6e3a1

# Bar background with alpha (#rrggbbaa) so picom can frost it — see the
# dock rule in picom.conf. Use $backgroundColor here to get an opaque bar.
set $barBackground #1e1e2ecc
set $accent #cba6f7
# <<< theme colors <<<


font pango:JetBrainsMono Nerd Font 8

# Start XDG autostart .desktop files
exec --no-startup-id dex --autostart --environment i3

# --- X session tweaks -------------------------------------------------------
# Without this the root window keeps X's legacy "X" bitmap cursor, which shows
# up on the desktop and while resizing.
exec_always --no-startup-id xsetroot -cursor_name left_ptr

# Key repeat: 250 ms before repeating, then 40 chars/s (X defaults to a
# sluggish 660 ms / 25 per second).
exec_always --no-startup-id xset r rate 250 40

# Idle policy, made explicit instead of relying on X defaults:
# blank the screen after 10 min (this is what triggers xss-lock below) and
# power the monitors down after 15.
exec_always --no-startup-id xset s 600 600
exec_always --no-startup-id xset dpms 900 900 900

# Lock screen: the i3lock-color invocation lives in a single script shared by
# xss-lock (suspend/loginctl) and the manual $mod+Escape binding.
set $locker ~/.config/i3/scripts/lock-screen.sh

# xss-lock grabs a logind suspend inhibit lock, so the screen is locked before
# suspend as well.
exec --no-startup-id xss-lock --transfer-sleep-lock -- $locker

# Lock the screen manually
bindsym $mod+Escape exec --no-startup-id loginctl lock-session

# NetworkManager tray applet
exec --no-startup-id nm-applet

# Agente de autenticação PolicyKit (o i3 não fornece um; sem isto o
# GNOME Software e afins falham com "Failed to obtain authentication").
exec_always --no-startup-id sh -c 'pgrep -f polkit-mate-authentication-agent >/dev/null || /usr/libexec/polkit-mate-authentication-agent-1 &'


# Volume control (PipeWire/WirePlumber): 5% steps, capped at 100%,
# with a dunst OSD progress bar.
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/volume-osd.sh up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/volume-osd.sh down
bindsym XF86AudioMute exec --no-startup-id ~/.config/i3/scripts/volume-osd.sh mute
bindsym XF86AudioMicMute exec --no-startup-id ~/.config/i3/scripts/volume-osd.sh mic-mute

# Media control
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioStop exec playerctl stop

# Brightness control (with dunst OSD)
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/i3/scripts/brightness-osd.sh up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/scripts/brightness-osd.sh down

floating_modifier $mod

# Drag tiling windows from anywhere in the window, not just the title bar
# (title bars are disabled here).
tiling_drag modifier

# start a terminal
bindsym $mod+Return exec wezterm

# kill focused window
bindsym $mod+Shift+q kill

# change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+ccedilla focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+ccedilla move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# --- Dual monitor (DP-0 | DP-4) --------------------------------------------
# Jump the focus between monitors
bindsym $mod+Ctrl+j focus output left
bindsym $mod+Ctrl+ccedilla focus output right
bindsym $mod+Ctrl+Left focus output left
bindsym $mod+Ctrl+Right focus output right

# Throw the focused window at the other monitor (focus follows it)
bindsym $mod+Ctrl+Shift+j move container to output left
bindsym $mod+Ctrl+Shift+ccedilla move container to output right
bindsym $mod+Ctrl+Shift+Left move container to output left
bindsym $mod+Ctrl+Shift+Right move container to output right

# Swap the whole workspace to the other monitor
bindsym $mod+Ctrl+less move workspace to output left
bindsym $mod+Ctrl+greater move workspace to output right

# Cycle through the workspaces of the focused monitor
bindsym $mod+Ctrl+Up workspace prev_on_output
bindsym $mod+Ctrl+Down workspace next_on_output

# Keep a floating window (video call, PiP, docs) on top across workspaces
bindsym $mod+Shift+y sticky toggle

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# scratchpad: hide the focused window / cycle through hidden windows
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Quake-style dropdown terminal (dedicated WezTerm on the scratchpad)
bindsym $mod+t exec --no-startup-id ~/.config/i3/scripts/dropdown-terminal.sh
for_window [class="dropdown-terminal"] floating enable, resize set 70 ppt 65 ppt, move scratchpad, scratchpad show

# ignore Libadwaita
exec --no-startup-id systemctl --user set-environment ADW_DISABLE_PORTAL=1

# Open Gnome Settings
bindsym $mod+Shift+s exec --no-startup-id XDG_CURRENT_DESKTOP=GNOME gnome-control-center

# Workspace labels: "<number> <icon>". The leading digits matter — every
# binding below uses `workspace number $wsN`, which matches on them, so the
# icons are cosmetic and the keys keep working.
set $ws1 "1 󰆍"
set $ws2 "2 󰖟"
set $ws3 "3 󰅴"
set $ws4 "4 󰈙"
set $ws5 "5 󰊌"
set $ws6 "6 󰝙"
set $ws7 "7 󰕧"
set $ws8 "8 󰊗"
set $ws9 "9 󰒓"
set $ws10 "10 󰍹"

# Pin workspaces to monitors: odd on the left (DP-0), even on the right (DP-4).
# Each lists the other output as fallback for single-monitor sessions.
workspace $ws1 output DP-0 DP-4
workspace $ws2 output DP-4 DP-0
workspace $ws3 output DP-0 DP-4
workspace $ws4 output DP-4 DP-0
workspace $ws5 output DP-0 DP-4
workspace $ws6 output DP-4 DP-0
workspace $ws7 output DP-0 DP-4
workspace $ws8 output DP-4 DP-0
workspace $ws9 output DP-0 DP-4
workspace $ws10 output DP-4 DP-0

# Pressing the current workspace's key again jumps back to the previous one
workspace_auto_back_and_forth yes
bindsym $mod+Tab workspace back_and_forth

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym --release $mod+Mod2+KP_1 workspace number $ws1
bindsym --release $mod+Mod2+KP_2 workspace number $ws2
bindsym --release $mod+Mod2+KP_3 workspace number $ws3
bindsym --release $mod+Mod2+KP_4 workspace number $ws4
bindsym --release $mod+Mod2+KP_5 workspace number $ws5
bindsym --release $mod+Mod2+KP_6 workspace number $ws6
bindsym --release $mod+Mod2+KP_7 workspace number $ws7
bindsym --release $mod+Mod2+KP_8 workspace number $ws8
bindsym --release $mod+Mod2+KP_9 workspace number $ws9
bindsym --release $mod+Mod2+KP_0 workspace number $ws10


# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10


bindsym --release $mod+Shift+KP_End move container to workspace number $ws1
bindsym --release $mod+Shift+KP_Down move container to workspace number $ws2
bindsym --release $mod+Shift+KP_Next move container to workspace number $ws3
bindsym --release $mod+Shift+KP_Left move container to workspace number $ws4
bindsym --release $mod+Shift+KP_Begin move container to workspace number $ws5
bindsym --release $mod+Shift+KP_Right move container to workspace number $ws6
bindsym --release $mod+Shift+KP_Home move container to workspace number $ws7
bindsym --release $mod+Shift+KP_Up move container to workspace number $ws8
bindsym --release $mod+Shift+KP_Prior move container to workspace number $ws9
bindsym --release $mod+Shift+KP_Insert move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session). i3-nagbar draws itself with the
# default Sans/grey X look and was the only untouched surface left in the rice,
# so the confirmation goes through the themed rofi prompt instead — the same
# one rofi_powermenu.sh uses.
bindsym $mod+Shift+e exec --no-startup-id ~/.local/bin/rofi_confirm.sh "Sair do i3" && i3-msg exit

# resize window (you can also use the mouse for that)
mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym ccedilla resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# adjust gaps on the fly
set $mode_gaps Gaps: (i)nner+ (Shift+i)nner- (o)uter+ (Shift+o)uter- (0) reset
mode "$mode_gaps" {
        bindsym i gaps inner current plus 5
        bindsym Shift+i gaps inner current minus 5
        bindsym o gaps outer current plus 5
        bindsym Shift+o gaps outer current minus 5
        bindsym 0 gaps inner current set 10; gaps outer current set 5

        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+Shift+g mode "$mode_gaps"


# No title bars, but keep a thin border: with `pixel 0` the only focus cue is
# the flashfocus flash, which is easy to miss on a dual-monitor setup.
# smart_borders hides it again whenever a workspace holds a single window.
# 4px, not 2px: picom masks the composited window (border included) with a
# 12px rounded rect, and along the corner arc that mask eats everything thinner
# than radius * (1 - 1/sqrt(2)) — 3.5px here. With a 2px border the accent line
# simply vanished across each corner and left a dark notch. Measured: 2px
# breaks over 5 rows, 3px over 2, 4px is continuous.
default_border pixel 4
default_floating_border pixel 4
smart_borders on


gaps inner 10
gaps outer 5

smart_gaps on

# --- Focus behaviour --------------------------------------------------------
# Do not wrap around the edge of a screen: at the rightmost window, "focus
# right" should land on the other monitor instead of jumping back to the left.
focus_wrapping no

# Dialogs that pop up over a fullscreen window only steal it when they are
# transient for the fullscreen window itself.
popup_during_fullscreen smart

# --- Window rules -----------------------------------------------------------
# Dialogs, pop-ups and settings windows behave better floating than tiled.
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="Preferences"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [class="Pavucontrol"] floating enable, resize set 900 600
for_window [class="Blueman-manager"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [class="(?i)gnome-control-center"] floating enable, resize set 1100 720
for_window [class="(?i)gnome-calculator"] floating enable
for_window [class="(?i)nm-openvpn-auth-dialog"] floating enable
for_window [class="(?i)spectacle"] floating enable, border pixel 0
for_window [class="(?i)zoom"] floating enable
for_window [class="Steam" title="^Steam - News"] floating enable
for_window [title="(?i)^(open|save) (file|folder|as)"] floating enable, resize set 1000 640

# Picture-in-picture: float it, keep it visible on every workspace and park it
# in the top-right corner of the current monitor.
for_window [title="(?i)picture[- ]in[- ]picture"] floating enable, sticky enable, resize set 560 315, move position 1340 45

# Games: let them keep the size they ask for instead of being squeezed into
# whatever tile happens to be free (Rocket League ended up in a 940x507 slot,
# which is not a resolution any game expects). Steam, Heroic and Lutris all
# label the window steam_app_<id>; gamescope wraps its own session.
# Borderless because a game draws its own frame.
for_window [class="^steam_app_[0-9]+$"] floating enable, border pixel 0
for_window [class="(?i)^gamescope$"] floating enable, border pixel 0
for_window [class="(?i)^(lutris|heroic)$" window_role="pop-up"] floating enable


# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
        status_command i3status-rs ~/.config/i3status/config.toml

        font pango:JetBrainsMono Nerd Font 10
        tray_output primary
        tray_padding 4
        height 25
        position top

        # Equal-width workspace buttons instead of ones that jump around as
        # the label changes.
        workspace_min_width 26

        # Scrolling over the bar switching workspaces is easy to trigger by
        # accident while reaching for a window.
        bindsym button4 nop
        bindsym button5 nop

        colors {
          # $barBackground carries an alpha channel so picom frosts the bar
          # (see the window_type = 'dock' rule in picom.conf).
          background $barBackground
          statusline $foreground
          separator  $selection

          focused_workspace  $accent $accent $backgroundColor
          active_workspace   $backgroundColor $selection $foreground
          inactive_workspace $barBackground $barBackground $comment
          urgent_workspace   $red $red $foreground
          binding_mode       $red $red $foreground
        }
}

# Hide/show the bar (fullscreen reading, screen recordings, ...)
bindsym $mod+Shift+b bar mode toggle

# Monitor layout: single xrandr call avoids races between mode and position,
# and marks DP-0 as primary (used by tray_output above).
exec_always --no-startup-id xrandr --output DP-0 --mode 1920x1080 --rate 144.00 --primary --output DP-4 --mode 1920x1080 --rate 144.00 --right-of DP-0

# Automatic split direction: new windows split the focused container along its
# longest side, so you stop pressing $mod+h / $mod+v by hand.
# The wrapper is a no-op when autotiling is already running (its IPC connection
# survives an in-place i3 restart, but exec_always fires on every reload).
exec_always --no-startup-id ~/.config/i3/scripts/autotiling.sh

# class                 border  bground text    indicator child_border
# The focused border carries $accent, the same colour as focused_workspace in
# the bar: with $comment it was a grey barely distinguishable from
# focused_inactive's $selection, which on two monitors made "which window has
# the focus" a guess. The indicator (split direction) shares the accent.
client.focused          $accent $accent $backgroundColor $accent   $accent
client.focused_inactive $selection $selection $foreground $selection   $selection
client.unfocused        $backgroundColor $backgroundColor $comment $backgroundColor   $backgroundColor
client.urgent           $selection $red $foreground $red   $red
client.placeholder      $backgroundColor $backgroundColor $foreground $backgroundColor   $backgroundColor

client.background       $foreground


# Rofi launcher
bindsym $mod+d exec --no-startup-id ~/.local/bin/rofi_launcher.sh
bindsym $mod+Shift+d exec --no-startup-id ~/.local/bin/rofi_sudo_launcher.sh

# Rofi power menu
bindsym $mod+p exec --no-startup-id ~/.local/bin/rofi_powermenu.sh

# Clipboard history (greenclip + rofi)
bindsym $mod+Shift+v exec --no-startup-id ~/.local/bin/rofi_clipboard.sh

# Calculator and emoji picker
bindsym $mod+equal exec --no-startup-id ~/.local/bin/rofi_calc.sh
bindsym $mod+period exec --no-startup-id sh -c 'command -v rofimoji >/dev/null && rofimoji --action copy'

# Rice/theme selector (Dracula, Gruvbox, Catppuccin, ...)
bindsym $mod+Shift+t exec --no-startup-id ~/.local/bin/theme-switcher.sh

# Wi-Fi picker (nmcli + rofi)
bindsym $mod+Shift+i exec --no-startup-id ~/.local/bin/rofi_wifi.sh

# Searchable cheat sheet of every binding in this config
bindsym $mod+F1 exec --no-startup-id ~/.local/bin/rofi_keybinds.sh

# Skip to the next wallpaper without waiting for the slideshow interval.
# The [w] keeps the regex from matching the shell i3 spawns to run pkill --
# that wrapper's own cmdline contains the pattern and SIGUSR1 would kill it.
bindsym $mod+F5 exec --no-startup-id pkill -USR1 -f '[w]allpaper-slideshow.sh'

# Pause/resume notifications (dunst do-not-disturb)
bindsym $mod+Shift+comma exec --no-startup-id ~/.local/bin/dunst-dnd.sh

# eww control-center dashboard
bindsym $mod+o exec --no-startup-id sh -c 'command -v eww >/dev/null && eww open --toggle dashboard'

# Save/restore workspace layout + programs (i3-resurrect)
bindsym $mod+F9 exec --no-startup-id sh -c 'command -v i3-resurrect >/dev/null && i3-resurrect save && notify-send -a i3-resurrect "󰆓 Workspace salvo"'
bindsym $mod+F10 exec --no-startup-id sh -c 'command -v i3-resurrect >/dev/null && i3-resurrect restore'

# background images slideshow (guarded against duplicate instances)
# exec_always so a config restart brings it back; the pidfile guard in the
# script keeps a second copy from starting when the first is still alive.
exec_always --no-startup-id ~/.config/i3/scripts/wallpaper-slideshow.sh

exec --no-startup-id numlockx on

# clipboard history daemon
exec --no-startup-id sh -c 'command -v greenclip >/dev/null && greenclip daemon'

# flash the window that receives focus (needs the compositor)
exec --no-startup-id sh -c 'command -v flashfocus >/dev/null && flashfocus'

# eww daemon (widgets)
exec --no-startup-id sh -c 'command -v eww >/dev/null && eww daemon'

# Compositor: kill any previous instance so an i3 restart picks up config changes
# (the pause lets the old instance release the compositor selection / GLX context)
exec_always --no-startup-id sh -c 'pkill -x picom; sleep 0.5; picom -b --config ~/.config/picom/picom.conf'

# Screenshots via Spectacle. No daemon to start: every binding launches it on
# demand. The clipboard modes go through screenshot.sh because Spectacle's own
# --copy-image loses the image as soon as it exits (see the script's comment).
# The region selector needs the qml-module-qtquick-shapes package: without it
# Spectacle silently exits instead of drawing the overlay.

# Screenshot: region selector, then the editor
bindsym Print exec --no-startup-id spectacle --region

# Screenshot: whole desktop to the clipboard
bindsym Shift+Print exec --no-startup-id ~/.config/i3/scripts/screenshot.sh full

# Screenshot: monitor under the cursor to the clipboard
bindsym Ctrl+Print exec --no-startup-id ~/.config/i3/scripts/screenshot.sh monitor

# Screenshot: focused window to the clipboard
bindsym Mod1+Print exec --no-startup-id ~/.config/i3/scripts/screenshot.sh window

# Screen recording. Spectacle does not record at all, so this is ffmpeg/x11grab
# driven by screen-record.sh; the same key starts and stops, saving to ~/Videos.
# Append --audio to the command below to capture desktop sound as well.

# Record: monitor holding the focused workspace
bindsym $mod+Print exec --no-startup-id ~/.config/i3/scripts/screen-record.sh monitor

# Record: whole desktop across every monitor
bindsym $mod+Shift+Print exec --no-startup-id ~/.config/i3/scripts/screen-record.sh full

bindsym $mod+b exec --no-startup-id brave-browser
bindsym $mod+c exec --no-startup-id google-chrome

# open nautilus
bindsym $mod+n exec --no-startup-id nautilus $HOME

for_window [class="rustdesk"] floating enable
for_window [class="Slack"] focus

bindsym $mod+Shift+n exec dunstctl history-pop
bindsym $mod+Shift+h exec ~/.local/bin/dunst-history.sh
