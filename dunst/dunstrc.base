# Base dunst configuration. Colors live in themes/<name>/dunst.conf;
# theme-switcher.sh concatenates both into ~/.config/dunst/dunstrc.
[global]
    # Show notifications on the monitor where the mouse pointer is
    follow = mouse

    # Anchor the stack just under the i3bar (bar height 25 + a 15px gap)
    # instead of letting dunst pick a default corner.
    origin = top-right
    offset = 15x42
    width = (300, 440)
    height = 320

    # Cap the stack so a burst of notifications cannot cover the screen;
    # the rest waits in the queue and is shown as "(N more)".
    notification_limit = 6

    # Separate cards instead of one glued column — this is what makes the
    # rounded corners actually visible.
    gap_size = 8

    font = "JetBrainsMono Nerd Font 10"
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    sticky_history = yes
    history_length = 30

    # A touch of transparency so picom's dual_kawase blur has something to
    # work with (see the Dunst rule in picom.conf).
    transparency = 12
    separator_height = 2
    padding = 12
    corner_radius = 12
    horizontal_padding = 12
    frame_width = 2
    separator_color = frame

    # Progress bar (used by the volume/brightness OSD)
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 180
    progress_bar_max_width = 400

    idle_threshold = 120

    icon_position = left
    min_icon_size = 24
    max_icon_size = 48
    # icon_theme is set per rice in themes/<name>/dunst.conf
    enable_recursive_icon_lookup = true

    # Context menu (dunstctl context) and "open URL" actions go through the
    # riced rofi theme instead of dmenu's default look.
    dmenu = /usr/bin/rofi -dmenu -p " dunst"
    browser = /usr/bin/xdg-open

    mouse_left_click = do_action, close_current
    mouse_middle_click = do_action, open_url
    mouse_right_click = close_all
