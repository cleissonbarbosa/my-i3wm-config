# Base dunst configuration. Colors live in themes/<name>/dunst.conf;
# theme-switcher.sh concatenates both into ~/.config/dunst/dunstrc.
[global]
    # Show notifications on the monitor where the mouse pointer is
    follow = mouse

    font = "JetBrainsMono Nerd Font 10"
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    sticky_history = yes
    history_length = 20

    transparency = 0
    separator_height = 2
    padding = 12
    corner_radius = 12
    horizontal_padding = 12
    frame_width = 2
    separator_color = frame

    # Progress bar (used by the volume/brightness OSD)
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0

    idle_threshold = 120

    icon_position = left
    min_icon_size = 24
    max_icon_size = 48
    icon_theme = "ZorinBlue-Dark, Adwaita, hicolor"
    enable_recursive_icon_lookup = true

    mouse_left_click = do_action, close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all
