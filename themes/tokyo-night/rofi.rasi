/* Tokyo Night rofi theme (managed by themes/theme-switcher.sh) */

* {
    /* The window background carries an alpha channel so picom's dual_kawase
       blur has something to work with (see the Rofi rule in picom.conf). */
    bg:        #1a1b26e6;
    bg-solid:  #1a1b26;
    bg-alt:    #292e42;
    fg:        #c0caf5;
    muted:     #565f89;
    accent:    #7aa2f7;
    urgent:    #f7768e;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    background-color: @bg;
    border:           2px;
    border-radius:    14px;
    border-color:     @accent;
    width:            38%;
    padding:          14px;
    children:         [ mainbox ];
}

mainbox {
    spacing:  10px;
    children: [ inputbar, message, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          10px 12px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:     @accent;
    vertical-align: 0.5;
}

entry {
    placeholder:       "Escreva aqui";
    placeholder-color: @muted;
    cursor:            text;
    vertical-align:    0.5;
}

listview {
    lines:        12;
    columns:      1;
    spacing:      4px;
    scrollbar:    false;
    fixed-height: false;
    dynamic:      true;
}

element {
    padding:       8px 10px;
    border-radius: 8px;
    spacing:       10px;
    children:      [ element-icon, element-text ];
}

element normal.normal   { text-color: @fg; }
element normal.urgent   { text-color: @urgent; }
element normal.active   { text-color: @accent; }
element alternate.normal { text-color: @fg; }

element selected.normal,
element selected.active {
    background-color: @accent;
    text-color:       @bg-solid;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @bg-solid;
}

element-icon {
    size:             22px;
    vertical-align:   0.5;
    background-color: transparent;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}

message {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          8px 12px;
}

textbox {
    text-color:     @fg;
    vertical-align: 0.5;
}

error-message {
    background-color: @bg-solid;
    border-radius:    10px;
    padding:          12px;
    text-color:       @urgent;
}
